# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ledgerlens:ledgerlens@localhost:5432/ledgerlens

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Supported: "gemini" | "openai" | "anthropic"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM model names (provider-specific defaults used if blank)
GEMINI_MODEL=gemini-2.5-pro
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-opus-4-5

# ─── Reconciliation Tuning ────────────────────────────────────────────────────
# Timestamp tolerance for fuzzy matching (hours)
FUZZY_MATCH_WINDOW_HOURS=6
STRICT_MATCH_WINDOW_HOURS=24

# Amount tolerance for fuzzy matching (INR)
AMOUNT_TOLERANCE_INR=0.01

# ─── Confidence Thresholds ────────────────────────────────────────────────────
AUTO_RESOLVE_THRESHOLD=0.95
REVIEW_THRESHOLD=0.75

# ─── Data Generator ───────────────────────────────────────────────────────────
GENERATOR_SEED=42

# ─── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000
